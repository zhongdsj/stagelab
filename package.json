{
  "name": "fourstage",
  "version": "0.1.0",
  "private": false,
  "description": "四阶段MCP项目管理工具 - 单一 npm CLI 包（server+web 一体，MCP 独立子命令）",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "fourstage": "./dist/cli.mjs"
  },
  "main": "./dist/cli.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build -w @fourstage/shared && npm run build -w @fourstage/server && npm run build -w @fourstage/web",
    "build:release": "node scripts/build-release.mjs",
    "prepublishOnly": "npm run build:release",
    "dev:mcp": "npm run dev:mcp -w @fourstage/server",
    "dev:http": "npm run dev:http -w @fourstage/server",
    "dev:index": "npm run dev:index -w @fourstage/server",
    "dev:web": "npm run dev -w @fourstage/web",
    "typecheck": "npm run typecheck -w @fourstage/shared && npm run typecheck -w @fourstage/server"
  },
  "dependencies": {
    "@fastify/static": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "elkjs": "^0.12.0",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}