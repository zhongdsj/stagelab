        "condition": "有聚焦模块"
      },
      "geometry": {
        "x": 0,
        "y": 1024,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "elk",
      "label": "ELK 布局计算",
      "nodeKind": "subprocess",
      "description": "elk.layout 计算节点坐标",
