        "x": 0,
        "y": 256,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "worker",
      "label": "进 Worker 线程",
      "nodeKind": "decision",
      "description": "大图走 Worker，小图同步",
      "payload": {
        "condition": "图较大"
      },
      "geometry": {
        "x": 0,
        "y": 512,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "build",
