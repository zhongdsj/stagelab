      "nodeKind": "process",
      "description": "registerRepo / removeRepo / pruneRegistryRepos 入口",
      "codeAnchor": {
        "files": [
          {
            "path": "packages/server/src/storage/registry.ts",
            "symbols": [
              "registerRepo",
              "removeRepo",
              "pruneRegistryRepos"
            ]
          }
        ]
      }
    },
    {
      "nodeId": "reg-lock",
      "label": "取跨进程文件锁",
      "nodeKind": "process",
      "description": "withLock(registry.lock) 串行化写入，消除多进程并发丢记录",
      "payload": {
        "aiRiskNote": {
          "concurrency": "无锁时多进程读-改-写会互相覆盖导致记录丢失",
          "mitigation": "复用 storage/lock.ts 文件锁 + 锁内重读"
        }
      },
      "codeAnchor": {
        "files": [
          {
            "path": "packages/server/src/storage/registry.ts",
            "symbols": [
              "withLock"
            ]
          },
          {
            "path": "packages/server/src/storage/lock.ts",
            "symbols": [
              "withLock"
            ]
          }
        ]
      }
    },
    {
      "nodeId": "reg-reload",
      "label": "锁内重读",
      "nodeKind": "process",
      "description": "持锁后重读 registry.json，避免用陈旧副本覆盖他进程刚写入的记录",
      "codeAnchor": {
        "files": [
          {
            "path": "packages/server/src/storage/registry.ts",
            "symbols": [
              "loadRegistry"
            ]
          }
        ]
      }
    },
    {
      "nodeId": "reg-prune",
      "label": "失效项增量删除",
      "nodeKind": "process",
      "description": "仅移除 .stagelab 缺失的仓库项（pruneRegistryRepos），不再整体覆盖写",
      "payload": {
        "aiRiskNote": {
          "bug": "旧实现整体覆盖 + 暂时性打开失败即剔除，导致项目记录丢失",
          "fix": "增量删除 + 仅 .stagelab 不存在才剔除 + 打开失败保留待重试"
        }
      },
      "codeAnchor": {
        "files": [
          {
            "path": "packages/server/src/storage/registry.ts",
            "symbols": [
              "pruneRegistryRepos"
            ]
          },
          {
            "path": "packages/server/src/storage/workspace.ts",
            "symbols": [
              "loadRegisteredWorkspaces"
            ]
          }
        ]
      }
    },
    {
      "nodeId": "reg-rename",
      "label": "原子 rename + 有限重试",
      "nodeKind": "process",
      "description": "renameWithRetry：EPERM/EBUSY/EACCES 退避重试（Windows 占用场景）",
      "payload": {
        "aiRiskNote": {
          "attempts": 5,
          "backoffMs": 20,
          "risk": "Windows 上 rename 可能因杀软/占用瞬时失败"
        }
      },
      "codeAnchor": {
        "files": [
          {
            "path": "packages/server/src/storage/registry.ts",
            "symbols": [
              "saveRegistry",
              "renameWithRetry"
            ]
          }
        ]
      }
    },
    {
      "nodeId": "reg-tmp-clean",
      "label": "回收本次 tmp",
      "nodeKind": "process",
      "description": "写成功或异常路径 finally 回收本次 registry.json.tmp-*",
      "codeAnchor": {
        "files": [
          {
            "path": "packages/server/src/storage/registry.ts",
            "symbols": [
              "saveRegistry"
            ]
          }
        ]
      }
    },
    {
      "nodeId": "reg-orphan",
      "label": "残留 tmp 待手动清理",
      "nodeKind": "process",
      "description": "进程崩溃等极端场景残留的 tmp 文件，无自动清理，由系统运维入口手动清理",
      "payload": {
        "aiRiskNote": {
          "cleanup": "仅手动清理（系统运维入口），刻意不做自动清理"
        }
      },
      "codeAnchor": {
        "files": [
          {
            "path": "packages/server/src/http/routes/system.ts",
            "symbols": [
              "registerSystemRoutes"
            ]
          }
        ]
      }
    }
