      "nodeId": "sys-route",
      "label": "系统运维路由",
      "nodeKind": "decision",
      "description": "GET/DELETE /api/system/registry-tmp：列表 / 单删 / 清空（仅手动触发，无自动清理）",
      "payload": {
        "aiRiskNote": {
          "autoClean": "刻意不做自动清理，避免误删正在写入的 tmp",
          "scope": "registry 临时文件运维，不触碰业务数据"
        }
      },
      "codeAnchor": {
        "files": [
          {
            "path": "packages/server/src/http/routes/system.ts",
            "symbols": [
              "registerSystemRoutes"
            ]
          }
        ]
      }
    },
    {
      "nodeId": "sys-guard",
      "label": "文件名安全校验",
      "nodeKind": "decision",
      "description": "正则白名单 ^registry\\.json\\.tmp-\\d+-[a-z0-9]+$ + path.resolve 后父目录必须等于注册表目录，否则 400",
      "payload": {
        "aiRiskNote": {
          "security": "防路径穿越：文件名白名单 + 解析后父目录比对双重校验"
        }
      },
      "codeAnchor": {
        "files": [
          {
            "path": "packages/server/src/http/routes/system.ts",
            "symbols": [
              "resolveTmpFile"
            ]
          }
        ]
      }
    }
