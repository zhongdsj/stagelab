        "condition": "有效"
      },
      "geometry": {
        "x": 911,
        "y": 320,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "f4-rebuild",
      "label": "rebuildIndex",
      "nodeKind": "process",
      "description": "重建索引",
      "geometry": {
        "x": 936,
        "y": 576,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "f4-return",
      "label": "返回两级索引",
      "nodeKind": "end",
      "description": "需求→任务 轻量摘要",
      "geometry": {
        "x": 911,
        "y": 832,
        "width": 152,
        "height": 56
      }
    }
