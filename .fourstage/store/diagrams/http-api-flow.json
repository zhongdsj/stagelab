{
  "diagramId": "http-api-flow",
  "type": "flow",
  "metadata": {
    "title": "HTTP API - 核心流程图",
    "version": 3,
    "description": "基于 packages/server/src/http 源码：前端请求→路由→服务层→布局/存储 的处理流程"
  },
  "nodes": [
    {
      "nodeId": "start",
