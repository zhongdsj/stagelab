      "geometry": {
        "x": 12,
        "y": 576,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "validate",
      "label": "参数校验",
      "nodeKind": "decision",
      "description": "title 必填 / status 白名单 / changeType 白名单",
      "payload": {
        "condition": "校验通过"
      },
      "geometry": {
        "x": 12,
        "y": 832,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "resolver",
      "label": "解析工作区",
      "nodeKind": "process",
      "description": "requireWorkspaceByProjectId",
      "geometry": {
        "x": 12,
        "y": 1088,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "svc",
      "label": "调用业务服务",
      "nodeKind": "process",
      "description": "ProjectService / DocumentService / DiagramService / RequirementService / IndexService",
      "geometry": {
        "x": 284,
        "y": 64,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "layout",
      "label": "布局计算路由",
      "nodeKind": "decision",
      "description": "GET /diagrams/:did/layout 走布局引擎",
      "payload": {
        "condition": "请求为 layout"
      },
      "geometry": {
        "x": 284,
        "y": 320,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "engine",
      "label": "布局引擎",
      "nodeKind": "subprocess",
      "description": "layoutInWorker 计算坐标",
      "payload": {
        "layer": "布局引擎"
      },
      "geometry": {
        "x": 284,
        "y": 576,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "err",
      "label": "错误处理",
      "nodeKind": "process",
      "description": "errorStatus 映射 404/422/409/500",
      "geometry": {
        "x": 556,
        "y": 64,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "end",
      "label": "返回响应",
      "nodeKind": "end",
      "description": "JSON 结果 + CORS 头",
      "geometry": {
        "x": 556,
        "y": 320,
        "width": 152,
        "height": 56
      }
    }
