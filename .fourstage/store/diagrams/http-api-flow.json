      "geometry": {
        "x": 12,
        "y": 64,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "cors",
      "label": "CORS 预检",
      "nodeKind": "decision",
      "description": "OPTIONS 预检直接 204",
      "payload": {
        "condition": "method === OPTIONS"
      },
      "geometry": {
        "x": 12,
        "y": 320,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "route",
      "label": "路由匹配",
