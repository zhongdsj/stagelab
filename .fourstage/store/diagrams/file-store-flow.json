{
  "diagramId": "file-store-flow",
  "type": "flow",
  "metadata": {
    "title": "本地存储层 - 核心流程图",
    "version": 3,
    "description": "基于 packages/server/src/storage 源码：读写安全（原子写+锁+mtime）与索引重建流程"
  },
  "nodes": [
    {
      "nodeId": "start",
      "label": "读写请求",
      "nodeKind": "start",
      "description": "服务层发起存储读写",
      "geometry": {
        "x": 12,
        "y": 64,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "path",
      "label": "解析路径",
      "nodeKind": "process",
      "description": "Paths 定位 .fourstage 文件",
      "geometry": {
        "x": 12,
        "y": 320,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "read",
      "label": "读分支",
      "nodeKind": "decision",
      "description": "读：检查缓存+mtime",
      "payload": {
        "condition": "读操作"
      },
      "geometry": {
        "x": 284,
        "y": 64,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "cache-hit",
      "label": "缓存有效？",
      "nodeKind": "decision",
      "description": "TTL 未过期且 mtime 未变",
      "payload": {
        "condition": "命中缓存"
      },
      "geometry": {
        "x": 284,
        "y": 320,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "disk-read",
      "label": "读磁盘 JSON",
      "nodeKind": "process",
      "description": "readJsonFile + 解析校验",
      "geometry": {
        "x": 284,
        "y": 576,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "write",
      "label": "写分支",
      "nodeKind": "process",
      "description": "acquireLock 获取写锁",
      "geometry": {
        "x": 556,
        "y": 64,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "conflict",
      "label": "磁盘 mtime 冲突？",
      "nodeKind": "decision",
      "description": "外部 Git 已改则拒绝",
      "payload": {
        "condition": "mtime 较新"
      },
      "geometry": {
        "x": 556,
        "y": 320,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "atomic",
      "label": "临时文件+原子 rename",
      "nodeKind": "process",
      "description": "写 tmp + fsync + rename 覆盖",
      "geometry": {
        "x": 556,
        "y": 576,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "release",
      "label": "释放锁+更新缓存",
      "nodeKind": "process",
      "description": "释放锁，记录新 mtime",
      "geometry": {
        "x": 556,
        "y": 832,
        "width": 152,
        "height": 56
      }
    },
    {
      "nodeId": "end",
      "label": "返回结果",
