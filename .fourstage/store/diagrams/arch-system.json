{
  "diagramId": "arch-system",
  "type": "architecture",
  "metadata": {
    "title": "四阶段MCP项目管理工具 - 系统架构",
    "version": 3,
    "description": "基于开发文档 5.1 整体架构：MCP Client(AI) 与 Web 前端通过 stdio/HTTP 接入 Node.js 后端，经业务服务层与布局引擎，落盘到本地文件存储层"
  },
  "nodes": [
    {
      "nodeId": "mcp-client",
      "label": "MCP Client (AI)",
      "layer": "接入层",
      "nodeKind": "external",
      "description": "AI 客户端，通过标准 MCP 协议(stdio)接入后端，执行项目管理/文档/图元/索引操作"
    },
    {
      "label": "Web 前端 (浏览器)",
      "nodeId": "web-frontend",
      "layer": "接入层",
      "nodeKind": "external",
      "description": "Vue3 SPA，通过 HTTP 访问后端 API，查看/编辑文档、渲染图表、管理任务",
      "payload": {
        "linkedDiagrams": [
          {
            "diagramId": "web-frontend-class",
            "label": "Web 前端 - 类图",
            "type": "class"
          },
          {
            "diagramId": "web-frontend-flow",
            "type": "flow",
            "label": "Web 前端 - 核心交互流程图"
          }
        ]
      }
    },
    {
      "nodeId": "mcp-server",
      "label": "MCP Server",
      "layer": "服务层",
      "nodeKind": "service",
      "description": "标准 MCP 协议实现(@modelcontextprotocol/sdk)，注册 25 个工具：项目管理/文档/需求任务/图元/索引"
    },
    {
      "nodeId": "http-api",
      "label": "HTTP API 层",
      "layer": "服务层",
      "nodeKind": "service",
      "description": "Fastify 提供前端 API：项目/布局/文档分片/需求任务，委托业务服务层与布局引擎"
    },
    {
      "nodeId": "biz-service",
      "label": "业务服务层",
      "layer": "服务层",
      "nodeKind": "service",
      "description": "项目管理/文档分片/图元CRUD/索引 四大服务；分层分片按需读取，降 Token"
    },
    {
      "nodeId": "layout-engine",
      "label": "布局引擎 (Worker)",
      "layer": "服务层",
      "nodeKind": "service",
      "description": "elkjs 计算节点坐标与连线路径，输出 LayoutDiagram；Worker 隔离支持大图计算与取消"
    },
    {
      "nodeId": "file-store",
      "label": "本地文件存储层",
      "layer": "数据层",
      "nodeKind": "database",
      "description": "Git 仓库内 .fourstage/ 目录，JSON 明文存储；mtime 检测 + 原子写 + 短时锁"
    }
  ],
  "edges": [
    {
      "edgeId": "e-mcp",
      "from": "mcp-client",
      "to": "mcp-server",
      "label": "stdio"
    },
    {
      "edgeId": "e-http",
      "from": "web-frontend",
      "to": "http-api",
      "label": "HTTP"
    },
    {
      "edgeId": "e-mcp-biz",
      "from": "mcp-server",
      "to": "biz-service",
      "label": "调用服务"
    },
    {
      "edgeId": "e-http-biz",
      "from": "http-api",
      "to": "biz-service",
      "label": "调用服务"
    },
    {
      "edgeId": "e-http-layout",
      "from": "http-api",
      "to": "layout-engine",
      "label": "布局计算"
    },
    {
      "edgeId": "e-biz-layout",
      "from": "biz-service",
      "to": "layout-engine",
      "label": "布局计算"
    },
    {
      "edgeId": "e-biz-store",
      "from": "biz-service",
      "to": "file-store",
      "label": "读写 JSON"
    }
  ],
  "groups": [
