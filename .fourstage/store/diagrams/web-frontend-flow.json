{
  "diagramId": "web-frontend-flow",
  "type": "flow",
  "metadata": {
    "title": "Web 前端 - 核心交互流程图",
    "version": 4,
    "description": "基于 packages/web 源码：项目总览→项目详情→四阶段内容（文档/图/需求任务）的交互流程；后端依赖统一以 BackendService 占位（横向泳道）"
  },
  "nodes": [
    {
      "nodeId": "start",
      "label": "启动 Web 应用",
      "nodeKind": "start",
      "description": "浏览器打开 SPA，Vue3 挂载"
    },
    {
      "nodeId": "load-projects",
      "label": "加载项目列表\nGET /api/projects",
      "nodeKind": "process",
      "description": "listProjects() 拉取全部项目"
    },
    {
      "nodeId": "render-overview",
      "label": "渲染项目总览",
      "nodeKind": "process",
      "description": "项目卡片网格 + 阶段标签 + 修改/删除按钮"
    },
    {
      "nodeId": "decision-op",
      "label": "用户操作？",
      "nodeKind": "decision",
      "description": "总览页操作分支"
    },
    {
      "nodeId": "create-project",
      "label": "新建项目\nPOST /api/projects",
      "nodeKind": "process",
      "description": "createProject(name, repoRoot)"
    },
    {
      "nodeId": "project-op",
      "label": "修改/删除项目\nPUT/DELETE",
      "nodeKind": "process",
      "description": "renameProject / deleteProject"
    },
    {
      "nodeId": "enter-detail",
      "label": "进入项目详情\nGET /projects/:id + /index",
      "nodeKind": "process",
      "description": "getProject + getProjectIndex 并行加载"
    },
    {
      "nodeId": "render-stage",
      "label": "渲染四阶段导航与统计",
      "nodeKind": "process",
      "description": "StageNav + 文档/图/需求/任务计数"
    },
    {
      "nodeId": "decision-stage",
      "label": "当前阶段？",
      "nodeKind": "decision",
      "description": "按 currentStage 渲染内容区"
    },
    {
      "nodeId": "view-doc",
      "label": "文档查看\nGET /documents/:docId/full",
      "nodeKind": "process",
      "description": "s1 文档库：选择文档，加载全文"
    },
    {
      "nodeId": "render-md",
      "label": "只读渲染\nmarked + DOMPurify",
      "nodeKind": "process",
      "description": "markdown 渲染 + XSS 消毒，展示摘要栏"
    },
    {
      "nodeId": "edit-doc",
      "label": "编辑保存\nPUT full + meta",
      "nodeKind": "process",
      "description": "renameDocument(标题/摘要) + updateFullDocument(正文)"
    },
    {
      "nodeId": "view-diagram",
      "label": "图查看\nGET /diagrams/:id + /layout",
      "nodeKind": "process",
      "description": "getDiagram 语义模型 + getLayout 布局"
    },
    {
      "nodeId": "render-svg",
      "label": "SVG 渲染",
      "nodeKind": "process",
      "description": "DiagramSvg 按类型渲染节点/连线/分组"
    },
    {
      "nodeId": "fold-module",
      "label": "折叠/展开模块\n重新布局",
      "nodeKind": "process",
      "description": "setFocus(moduleId) → getLayout 重算"
    },
    {
      "nodeId": "view-req",
      "label": "需求任务\nGET /requirements",
      "nodeKind": "process",
      "description": "s2/s3 需求清单：展开需求懒加载任务"
    },
    {
      "nodeId": "task-op",
      "label": "任务操作\nPUT/POST/DELETE /tasks",
      "nodeKind": "process",
      "description": "状态切换 / 创建 / 修改 / 删除"
    },
    {
      "nodeId": "backend",
      "label": "BackendService (占位)",
      "nodeKind": "subprocess",
      "description": "外部模块统一占位：HTTP API 层 + 业务服务层 + 布局引擎 + 本地文件存储"
    },
    {
      "nodeId": "end",
      "label": "结束",
      "nodeKind": "end",
      "description": "页面交互完成"
    }
  ],
  "edges": [
    {
